APP_ENV=development
AUTH_MODE=local
STORAGE_PROVIDER=local
MOCK_AI=true
# scripts/setup.ps1 replaces this marker with a random local signing secret.
LOCAL_AUTH_SECRET=GENERATE_WITH_SETUP_SCRIPT
DATABASE_URL=sqlite:///./.data/linktoon.db
REDIS_URL=redis://localhost:6379/0
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOCAL_STORAGE_PATH=.data/assets
MAX_UPLOAD_BYTES=10485760
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=linktoon-private
# Leave blank for MockProvider. For real Story/Image generation, inject this into the Worker only.
OPENAI_API_KEY=
OPENAI_STORY_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_REFERENCE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_FORMAT=webp
OPENAI_TIMEOUT_SECONDS=90
# Select openai or fal for new Scene Image and Character reference Jobs.
IMAGE_PROVIDER=openai
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/flux-2-pro
FAL_REFERENCE_IMAGE_MODEL=fal-ai/flux-pulid
RUNWAYML_API_SECRET=
RUNWAY_VIDEO_MODEL=gen4_turbo
RUNWAY_VIDEO_DURATION_SECONDS=5
RUNWAY_API_VERSION=2024-11-06
MAX_VIDEO_BYTES=104857600
AI_QUOTAS_ENABLED=true
STORY_DAILY_LIMIT=10
IMAGE_DAILY_LIMIT=5
MOTION_DAILY_LIMIT=2
WORKER_ID=
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_LEASE_SECONDS=120
WORKER_BATCH_SIZE=10
WORKER_MAX_RETRIES=3
WORKER_RETRY_BASE_SECONDS=2
WORKER_PROVIDER_POLL_SECONDS=2
