APP_ENV=development
AUTH_MODE=local
STORAGE_PROVIDER=local
MOCK_AI=true
# scripts/setup.ps1 replaces this marker with a random local signing secret.
LOCAL_AUTH_SECRET=GENERATE_WITH_SETUP_SCRIPT
DATABASE_URL=sqlite:///./.data/linktoon.db
REDIS_URL=redis://localhost:6379/0
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
LOCAL_STORAGE_PATH=.data/assets
MAX_UPLOAD_BYTES=10485760
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=linktoon-private
OPENAI_API_KEY=
FAL_KEY=
RUNWAYML_API_SECRET=
AI_QUOTAS_ENABLED=true
STORY_DAILY_LIMIT=10
IMAGE_DAILY_LIMIT=5
MOTION_DAILY_LIMIT=2
